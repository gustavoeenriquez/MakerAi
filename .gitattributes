# Configuración por defecto
* text=auto

# Archivos de código fuente Delphi: LF en el repo, CRLF al hacer checkout
# y en el ZIP de GitHub (git archive). RAD Studio exige CRLF (issue #133).
*.pas text eol=crlf
*.dfm text eol=crlf
*.fmx text eol=crlf
*.dpr text eol=crlf
*.inc text eol=crlf
*.txt text
*.md text

# Archivos de proyecto Delphi (NO convertir - mantener CRLF)
*.dpk -text
*.dproj -text
*.groupproj -text
*.dsk -text
*.identcache -text
*.local -text
*.cfg -text

# Archivos binarios
*.exe binary
*.dll binary
*.bpl binary
*.dcu binary
*.res binary
*.dcr binary
*.bmp binary
*.ico binary
*.jpg binary
*.png binary
*.gif binary
*.pdf binary
*.wav binary
*.mp3 binary
*.m4a binary
*.webp binary
