  object AiFunctions1: TAiFunctions
    Functions = <
      item
        FunctionName = 'consultar_inventario'
        OnAction = FnConsultarInventario
        Description.Strings = (
          'Cu'#225'ntas bolsas de 340 g hay disponibles de un caf'#233' de la carta.')
        Parameters = <
          item
            Name = 'cafe'
            ParamType = ptString
            Description.Strings = (
              'Nombre del caf'#233' tal como est'#225' en la carta (Huila Reserva, Nari'#241'o Altura, Sierra Nevada Org'#225'nico, Descafeinado Suave).')
            Required = True
          end>
        Default = False
        Tag = 0
        ToolType = tt_function
      end
      item
        FunctionName = 'calcular_total'
        OnAction = FnCalcularTotal
        Description.Strings = (
          'Cotiza un pedido de un caf'#233': precio por las bolsas m'#225's el env'#237'o a la ciudad. Devuelve subtotal, env'#237'o y total en COP.')
        Parameters = <
          item
            Name = 'cafe'
            ParamType = ptString
            Description.Strings = (
              'Nombre del caf'#233' tal como est'#225' en la carta.')
            Required = True
          end
          item
            Name = 'bolsas'
            ParamType = ptInteger
            Description.Strings = (
              'N'#250'mero de bolsas de 340 g.')
            Required = True
          end
          item
            Name = 'ciudad'
            ParamType = ptString
            Description.Strings = (
              'Ciudad de entrega en Colombia.')
            Required = True
          end>
        Default = False
        Tag = 0
        ToolType = tt_function
      end
      item
        FunctionName = 'buscar_en_el_manual'
        OnAction = FnBuscarManual
        Description.Strings = (
          'Busca en el manual de la tienda: env'#237'os y tarifas, molienda, Club La Ladera (suscripci'#243'n), cambios y devoluciones, tosti'#243'n y frescura, horarios de atenci'#243'n. Devuelve los pasajes relevantes.')
        Parameters = <
          item
            Name = 'pregunta'
            ParamType = ptString
            Description.Strings = (
              'La pregunta del cliente, tal como la hizo.')
            Required = True
          end>
        Default = False
        Tag = 0
        ToolType = tt_function
      end>
    Left = 424
    Top = 64
  end
