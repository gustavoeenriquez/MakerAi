  object AiFunctions1: TAiFunctions
    MCPClients = <
      item
        Enabled = True
        Name = 'bodega'
        TransportType = tpStdIo
        Params.Strings = (
          'Command=BodegaLadera.exe'
          'Arguments=--servidor')
      end>
    OnLog = AiFunctions1Log
    Functions = <
      item
        FunctionName = 'consultar_inventario'
        OnAction = FnConsultarInventario
        Description.Strings = (
          'Cu'#225'ntas bolsas de 340 g hay disponibles de un caf'#233' de la carta.')
        Parameters = <
          item
            Name = 'cafe'
            ParamType = ptString
            Description.Strings = (
              'Nombre del caf'#233' tal como est'#225' en la carta (Huila Reserva, Nari'#241'o Altura, Sierra Nevada Org'#225'nico, Descafeinado Suave).')
            Required = True
          end>
        Default = False
        Tag = 0
        ToolType = tt_function
      end
      item
        FunctionName = 'calcular_total'
        OnAction = FnCalcularTotal
        Description.Strings = (
          'Cotiza un pedido de un caf'#233': precio por las bolsas m'#225's el env'#237'o a la ciudad. Devuelve subtotal, env'#237'o y total en COP.')
        Parameters = <
          item
            Name = 'cafe'
            ParamType = ptString
            Description.Strings = (
              'Nombre del caf'#233' tal como est'#225' en la carta.')
            Required = True
          end
          item
            Name = 'bolsas'
            ParamType = ptInteger
            Description.Strings = (
              'N'#250'mero de bolsas de 340 g.')
            Required = True
          end
          item
            Name = 'ciudad'
            ParamType = ptString
            Description.Strings = (
              'Ciudad de entrega en Colombia.')
            Required = True
          end>
        Default = False
        Tag = 0
        ToolType = tt_function
      end
      item
        FunctionName = 'buscar_en_el_manual'
        OnAction = FnBuscarManual
        Description.Strings = (
          'Busca en el manual de la tienda: env'#237'os y tarifas, molienda, Club La Ladera (suscripci'#243'n), cambios y devoluciones, tosti'#243'n y frescura, horarios de atenci'#243'n. Devuelve los pasajes relevantes.')
        Parameters = <
          item
            Name = 'pregunta'
            ParamType = ptString
            Description.Strings = (
              'La pregunta del cliente, tal como la hizo.')
            Required = True
          end>
        Default = False
        Tag = 0
        ToolType = tt_function
      end
      item
        FunctionName = 'que_sabemos_de'
        OnAction = FnQueSabemosDe
        Description.Strings = (
          'Lo que la tienda sabe de un cliente o de un caf'#233': gustos, compras, qu'#233' le gust'#243' y qu'#233' no, c'#243'mo prepara el caf'#233', notas de sabor, acidez. Devuelve hechos del grafo de conocimiento.')
        Parameters = <
          item
            Name = 'nombre'
            ParamType = ptString
            Description.Strings = (
              'Nombre del cliente o del caf'#233' (por ejemplo Marta, Huila Reserva).')
            Required = True
          end>
        Default = False
        Tag = 0
        ToolType = tt_function
      end
      item
        FunctionName = 'cafes_por_acidez'
        OnAction = FnCafesPorAcidez
        Description.Strings = (
          'Lista los caf'#233's de la carta que tienen un nivel de acidez dado.')
        Parameters = <
          item
            Name = 'nivel'
            ParamType = ptString
            Description.Strings = (
              'Nivel de acidez: Baja, Alta o Brillante.')
            Required = True
          end>
        Default = False
        Tag = 0
        ToolType = tt_function
      end
      item
        FunctionName = 'atender_reclamo'
        OnAction = FnAtenderReclamo
        Description.Strings = (
          'Atiende el reclamo de un cliente por un pedido: lo consulta, programa el cambio si fue error de la tienda y redacta la respuesta revisada. Devuelve la respuesta lista para el cliente.')
        Parameters = <
          item
            Name = 'mensaje'
            ParamType = ptString
            Description.Strings = (
              'El mensaje completo del cliente, tal como lo escribi'#243'.')
            Required = True
          end>
        Default = False
        Tag = 0
        ToolType = tt_function
      end
      item
        FunctionName = 'procesar_pedido'
        OnAction = FnProcesarPedido
        Description.Strings = (
          'Registra y confirma un pedido de bolsas de 340 g: verifica inventario, cotiza, calcula el env'#237'o y decide el despacho. Devuelve el mensaje final para el cliente.')
        Parameters = <
          item
            Name = 'items'
            ParamType = ptString
            Description.Strings = (
              'Los productos, como ''cantidad nombre, cantidad nombre'' (por ejemplo ''2 Huila Reserva, 1 Nari'#241'o Altura'').')
            Required = True
          end
          item
            Name = 'ciudad'
            ParamType = ptString
            Description.Strings = (
              'Ciudad de entrega en Colombia.')
            Required = True
          end>
        Default = False
        Tag = 0
        ToolType = tt_function
      end
      item
        FunctionName = 'aplicar_descuento'
        OnAction = FnAplicarDescuento
        Description.Strings = (
          'Fija el porcentaje de descuento de un pedido (reemplaza el que tuviera).')
        Parameters = <
          item
            Name = 'numero'
            ParamType = ptString
            Description.Strings = (
              'N'#250'mero del pedido.')
            Required = True
          end
          item
            Name = 'porcentaje'
            ParamType = ptInteger
            Description.Strings = (
              'Porcentaje de descuento (entero).')
            Required = True
          end>
        Default = False
        Tag = 0
        ToolType = tt_function
      end
      item
        FunctionName = 'anular_pedido'
        OnAction = FnAnularPedido
        Description.Strings = (
          'Anula un pedido y reembolsa el dinero.')
        Parameters = <
          item
            Name = 'numero'
            ParamType = ptString
            Description.Strings = (
              'N'#250'mero del pedido.')
            Required = True
          end>
        Default = False
        Tag = 0
        ToolType = tt_function
      end>
    Guardrails = Guardia
    Left = 424
    Top = 64
  end
